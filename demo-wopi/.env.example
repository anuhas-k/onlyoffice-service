# Copy to .env and fill in. Never commit .env.
# Generate each secret on its own line:  openssl rand -hex 32
DS_JWT_SECRET=
APP_SECRET=

# The app image to run (a name you built or loaded; see DOCKER.md)
APP_IMAGE=demo-wopi-app:1.0

# Ports on this machine
APP_PORT=3001
DS_PORT=8081

# How BROWSERS reach the two services. localhost is right on a single machine; use the
# machine's real host name when other people connect. The port must match APP_PORT / DS_PORT.
DS_PUBLIC_URL=http://localhost:8081
APP_PUBLIC_URL=http://localhost:3001

# off | log | enforce  (log = report WOPI proof-key mismatches but allow the call)
WOPI_PROOF=log
